<!-- Raptive Ad Block Recovery Script -->

<script type="text/javascript" async src="https://btloader.com/tag?o=5698917485248512&upapi=true&domain=exrx.net"></script>
<script>  
$(document).ready(function() {
// Detect if mobile or desktop
        const isMobile = window.innerWidth <= 768;
        
        let selectors;
        if (isMobile) {
            // Mobile: exclude certain selectors
            selectors = '#header_ad, #content_ad';
        } else {
            // Desktop: exclude different selectors
            selectors = '#header_ad, #sidebar_short_ad, #sidebar_short_long_ad, #content_ad';
        }
    // Function to add the "Remove Ads" banner
    function addRemoveAdsBanner() {
        $(
          selectors
        ).each(function() {
                $(this).prepend(
                    '<div style="display: flex; align-items: center; margin: 10px 0; font-size: 11.5px;">' +
                    '<hr style="flex: 1; margin: 0 !important; border: none; border-top: 1px solid #ccc;">' +
                    '<a href="/Premium" style="' +
                        'text-decoration: none; ' +
                        'background: rgba(128, 128, 128, 0.3); ' +
                        'padding: 1.5px 6px; ' +
                        'border-radius: 3px; ' +
                        'color: #333; ' +
                        'display: inline-block;' +
                        'border-bottom: none;' +
                    '"><span style="margin-right: 4px;">✕</span>Remove Ads</a>' +
                    '<hr style="flex: 1; margin: 0 !important; border: none; border-top: 1px solid #ccc;">' +
                '</div>'
                );
        });
    }
  
  
  function checkAndAddBanner() {
    if (window.adthrive && window.adthrive.cls) {
        addRemoveAdsBanner();
    } else {
        setTimeout(checkAndAddBanner, 100);
    }
}

checkAndAddBanner();
  
});
</script>

